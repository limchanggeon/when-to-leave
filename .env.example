# 언제나가 — 환경변수 본보기
#
#   cp .env.example .env
#
# **값은 여기 적지 않는다.** 이 파일은 저장소에 들어가고 저장소는 공개다.
# 값이 필요한 곳은 두 군데다:
#   로컬 개발 → .env            (.gitignore 에 들어 있다)
#   운영      → /etc/whenigo.env (서버에만 있다)
#
# VITE_ 로 시작하는 것은 **브라우저 번들에 그대로 박힌다.** 숨길 수 없으니
# 비밀값에는 절대 붙이지 말 것. 그 키들은 각 콘솔에서 도메인을 묶어 지킨다.

# ── 브라우저에 나가는 값 (숨길 수 없음) ────────────────────────────
VITE_KAKAO_JS_KEY=
VITE_KAKAO_REDIRECT_URI=
VITE_KAKAO_SCOPE=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_KEY=
# 구글 애드센스 게시자 ID(ca-pub-...). **비워두면 광고 스크립트가 아예 안 들어간다.**
# 승인 전에 넣어두면 광고는 하나도 안 나오면서 913 kB 를 받아오고 LCP 가 1.34초 늘어난다.
# 도메인을 사고 승인받은 뒤에 채운다.
VITE_ADSENSE_CLIENT=

# ── 서버만 아는 값 ────────────────────────────────────────────────
# 세션 쿠키 서명. 아무 긴 무작위 문자열이면 된다. 바꾸면 전원 로그아웃된다.
SESSION_SECRET=

# 카카오 (지도·길찾기·장소·로그인)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 구글 로그인. GOOGLE_CLIENT_ID 는 VITE_ 쪽과 **같은 값**을 둘 다 채운다 —
# 운영은 서버 env 와 빌드 env 가 다른 파일이라 한쪽만 넣으면 로그인이 죽는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_MAPS_SERVER_KEY=

# 국토교통부 공공데이터(TAGO). 서비스마다 따로 신청해야 하고 키는 하나를 쓴다.
# 열차·고속버스·시외버스·지하철·항공·버스노선·버스정류소·버스도착
TAGO_SERVICE_KEY=

# 메일. console 이면 로그에만 찍힌다 — 운영에서 그러면 메일이 조용히 사라진다.
MAIL_TRANSPORT=console
MAIL_FROM=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 문의를 받을 주소. 비워두면 코드의 기본값을 쓴다.
CONTACT_TO=

# 메일 속 링크가 가리킬 주소. 운영은 https://whenigo.p-e.kr
PUBLIC_ORIGIN=http://localhost:5173

# ── 운영에서만 쓰는 것 (systemd 가 넣어준다) ──────────────────────
# PORT=8787
# DB_PATH=/var/lib/whenigo/app.db
# BACKUP_DIR=/var/backups/whenigo
# BACKUP_KEEP=14
# BACKUP_S3_BUCKET=whenigo-backup
