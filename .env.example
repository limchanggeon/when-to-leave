# 복사해서 .env 로 만들고 값을 채우세요. .env 는 커밋되지 않습니다.
#
# 카카오 JavaScript 키 — 지도 SDK + 카카오 로그인이 함께 씁니다.
#   https://developers.kakao.com/console/app 에서 앱 생성 후
#   [앱 키] > JavaScript 키를 복사하고,
#   [플랫폼] > Web 에 http://localhost:4173 과 배포 도메인을 등록하세요.
#   카카오 로그인을 쓰려면 [카카오 로그인] 활성화 + Redirect URI 등록이 필요합니다.
VITE_KAKAO_JS_KEY=

# Google Maps JavaScript API 키 (해외 구간 지도)
#   https://console.cloud.google.com/google/maps-apis
#   Maps JavaScript API 활성화 후 키 발급. HTTP 리퍼러 제한을 걸어두세요.
VITE_GOOGLE_MAPS_KEY=

# Google Identity Services 클라이언트 ID (구글 로그인)
#   https://console.cloud.google.com/apis/credentials
#   [OAuth 클라이언트 ID] > 웹 애플리케이션.
#   승인된 JavaScript 원본에 http://localhost:4173 과 배포 도메인을 등록하세요.
VITE_GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────
# 서버 전용 (server/) — VITE_ 접두사를 붙이면 안 됩니다.
# VITE_ 로 시작하면 클라이언트 번들에 그대로 박혀 브라우저로 샙니다.
# ─────────────────────────────────────────────────────────

# 카카오 REST API 키 — JavaScript 키와 다른 값입니다.
#   개발자 콘솔 > 앱 설정 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 카카오 client_secret — 콘솔에서 활성화한 경우에만 채우세요.
#   제품 설정 > 카카오 로그인 > 보안 > Client Secret
KAKAO_CLIENT_SECRET=

# 세션 쿠키 서명용. 운영 전에 반드시 임의의 긴 문자열로 바꾸세요.
#   생성 예: openssl rand -hex 32
SESSION_SECRET=

# ODsay 대중교통 길찾기 (실제 경로 데이터)
#   https://lab.odsay.com 에서 가입 후 [API 인증키] > 웹서비스 키 발급.
#   없으면 목업 데이터가 대신 쓰이고, 화면에 MOCK 배지가 남습니다.

# ODsay Service URI — Web 키를 쓸 때 필요합니다.
#   콘솔의 [Service URI] 에 등록한 값과 같아야 합니다.
#   비워두면 http://localhost:4173 을 씁니다.
#   Server 키(고정 IP 등록)를 발급받았다면 신경 쓰지 않아도 됩니다.

# 구글 캘린더 연동 (일정 추가)
#   Cloud Console > OAuth 클라이언트 ID > 클라이언트 보안 비밀번호
GOOGLE_CLIENT_SECRET=

# 캘린더 동의 후 돌아올 주소.
#   구글 콘솔 [승인된 리디렉션 URI] 에 아래 두 개를 등록하세요.
#     http://localhost:4173/api/calendar/callback
#     http://localhost:5173/api/calendar/callback
#   /api 로 시작해야 합니다 — vite 가 /api 만 서버로 프록시합니다.
#   비워두면 http://localhost:4173/api/calendar/callback 을 씁니다.
GOOGLE_REDIRECT_URI=

# 구글 지도 서버용 키 (해외 경로: Routes API + Geocoding API)
#   브라우저용 키(VITE_GOOGLE_MAPS_KEY)는 리퍼러 제한이 걸려 있어 서버에서 거부됩니다.
#   Cloud Console 에서 아래 두 API 를 사용 설정하고, 제한 없는(또는 IP 제한) 키를 넣으세요.
#     - Routes API
#     - Geocoding API
#   비워두면 브라우저 키로 시도하고, 막히면 화면에 이유가 표시됩니다.
GOOGLE_MAPS_SERVER_KEY=

# 공공데이터포털 TAGO 열차정보 (국내 열차 시각표)
#   https://www.data.go.kr/data/15098552/openapi.do 에서 활용신청(자동승인, 무료)
#   디코딩된 일반 인증키를 넣습니다(코드가 알아서 인코딩합니다).
TAGO_SERVICE_KEY=
