# /etc/caddy/Caddyfile
#
# Caddy 가 인증서를 알아서 받아오고 갱신한다. 80/443 이 열려 있고
# 도메인의 A 레코드가 이 서버를 가리키고 있어야 한다.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# p-e.kr 은 Public Suffix List 에 없어서 Let's Encrypt 의
# "도메인당 주 50장" 한도를 p-e.kr 쓰는 다른 사람들과 나눠 쓴다.
# 한도에 걸리면 Caddy 가 ZeroSSL 로 알아서 넘어가므로 대개 그냥 발급된다.
# 둘 다 실패하면 journalctl -u caddy 에 이유가 찍힌다.

whenigo.p-e.kr {
	encode zstd gzip

	header {
		# HTTPS 로만 오게 못 박는다. 한 번 받은 브라우저는 http 로 붙지 않는다.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 브라우저가 Content-Type 을 제멋대로 추측하지 않게 한다.
		X-Content-Type-Options "nosniff"
		# 남의 페이지 안에 우리 화면을 끼워 넣지 못하게 한다(클릭재킹).
		X-Frame-Options "DENY"
		# 바깥으로 나갈 때 주소 전체를 넘기지 않는다 — 검색어가 새어나갈 수 있다.
		Referrer-Policy "strict-origin-when-cross-origin"
		# 쓰지 않는 장치 권한은 닫는다. 위치는 "현재 위치" 버튼이 쓰므로 연다.
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
		# 서버 종류를 굳이 알릴 이유가 없다.
		-X-Powered-By

		# 어디서 무엇을 불러올 수 있는지. 실제로 부르는 곳만 적었다 —
		# 브라우저로 강제해 보며 맞춘 목록이라, 출처가 늘면 여기도 늘려야 한다.
		#   script  카카오 지도 SDK(dapi·t1.daumcdn), 카카오 로그인 SDK(t1.kakaocdn),
		#           구글 로그인(accounts.google)
		#   style   구글 폰트. 'unsafe-inline' 은 지도 SDK 가 스타일을 직접
		#           박아 넣어서 필요하다 — 빼면 지도가 깨진다
		#   img     지도 타일(daumcdn), 프로필 사진(kakaocdn·googleusercontent)
		#   connect 우리 API 와 카카오 지도, 그리고 애드센스
		#   ads     애드센스는 스크립트를 더 불러오고 프레임을 띄운다.
		#           막힌 채로 두면 광고가 조용히 안 나온다
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://kauth.kakao.com https://accounts.kakao.com; script-src 'self' https://dapi.kakao.com https://t1.daumcdn.net https://t1.kakaocdn.net https://accounts.google.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://googleads.g.doubleclick.net https://*.doubleclick.net https://adservice.google.com https://www.google.com https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.daumcdn.net https://*.kakaocdn.net https://lh3.googleusercontent.com https://ssl.gstatic.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; connect-src 'self' https://dapi.kakao.com https://accounts.google.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; frame-src https://accounts.google.com https://kauth.kakao.com https://accounts.kakao.com https://googleads.g.doubleclick.net https://*.googlesyndication.com https://www.google.com https://*.adtrafficquality.google; worker-src 'self' blob:"
	}

	reverse_proxy 127.0.0.1:8787

	log {
		output file /var/log/caddy/whenigo.log
		format console
	}
}
