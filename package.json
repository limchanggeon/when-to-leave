{
  "name": "when-to-leave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "//": "node:sqlite 는 Node 22.5 부터 있다. 그 아래에서는 서버가 아예 못 뜬다.",
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "server": "tsx watch --env-file=.env server/index.ts",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch --env-file=.env server/index.ts\"",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.server.json",
    "start": "tsx server/index.ts",
    "backup": "tsx server/backup.ts",
    "admin:list": "tsx server/adminCli.ts list",
    "admin:grant": "tsx server/adminCli.ts grant",
    "admin:revoke": "tsx server/adminCli.ts revoke",
    "terminals:build": "tsx --env-file=.env server/buildTerminalCoords.ts",
    "terminals:verify": "tsx --env-file=.env server/verifyTerminalCoords.ts",
    "admin:create": "tsx server/createAdmin.ts",
    "app:build": "tsx scripts/appBuild.ts",
    "app:apk": "pnpm app:build && cd android && ./gradlew assembleDebug",
    "app:open": "pnpm app:build && cap open android",
    "app:icons": "tsx scripts/appIcons.ts",
    "app:release": "pnpm app:build && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "express": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
