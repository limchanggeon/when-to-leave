{
  "name": "when-to-leave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "//": "node:sqlite 는 Node 22.5 부터 있다. 그 아래에서는 서버가 아예 못 뜬다.",
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "server": "tsx watch --env-file=.env server/index.ts",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch --env-file=.env server/index.ts\"",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.server.json",
    "start": "tsx server/index.ts"
  },
  "pnpm": {
    "//": "pnpm 11 은 의존성의 빌드 스크립트를 기본으로 막는다. esbuild 는 이 단계에서 자기 바이너리를 놓으므로, 막히면 vite build 가 실패한다.",
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "express": "^5.2.1",
    "tsx": "^4.23.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
